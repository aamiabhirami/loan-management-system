MONGODB_URI=mongodb://127.0.0.1:27017/mitra?replicaSet=rs0
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-random-secret-of-at-least-32-bytes

# First administrator bootstrap. Leave the password blank to generate one once.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Connect a private Vercel Blob store. Vercel deployments use OIDC automatically.
# For local development, pull these values with `vercel env pull`.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Legacy Cloudinary credentials are only needed to access older customer documents.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
