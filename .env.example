MONGODB_URI=mongodb://127.0.0.1:27017/mitra?replicaSet=rs0
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-random-secret-of-at-least-32-bytes

# First administrator bootstrap. Leave the password blank to generate one once.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Private customer document storage. Keep the API secret server-side only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
